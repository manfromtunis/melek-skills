{
  "projectName": "Clip2Earn",
  "framework": "Next.js 15.3.1",
  "uiLibrary": "Hero UI",
  "styling": "Tailwind CSS 4.1.11",
  "darkMode": {
    "enabled": true,
    "strategy": "class",
    "defaultTheme": "dark"
  },
  "fonts": {
    "sans": {
      "family": "Inter",
      "variable": "--font-sans",
      "subsets": ["latin"],
      "display": "swap"
    },
    "mono": {
      "family": "Fira Code",
      "variable": "--font-mono",
      "subsets": ["latin"],
      "display": "swap"
    },
    "chakra": {
      "family": "Chakra Petch",
      "variable": "--font-chakra",
      "subsets": ["latin"],
      "weights": ["400", "500", "600", "700"],
      "display": "swap"
    },
    "generalSansFallback": {
      "family": "Plus Jakarta Sans",
      "variable": "--font-general-sans",
      "subsets": ["latin"],
      "weights": ["400", "500", "600", "700"],
      "display": "swap"
    }
  },
  "colors": {
    "custom": {
      "dark-text-secondary": "#A8A8A8"
    },
